# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — E-Commerce Product Search System
#  Copy this file to .env and fill in your values.
#  .env is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite — default, no changes needed)
DATABASE_URL=sqlite:///./app/data/products.db

# Production (PostgreSQL — uncomment and fill in)
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_search

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Search Defaults (override config.py at runtime) ──────────────────────────
# These are optional; config.py defaults are used when not set.
# BM25_K1=1.5
# BM25_B=0.75
# DEFAULT_SEARCH_MODE=bm25
# DEFAULT_PAGE_SIZE=10
# MAX_PAGE_SIZE=100
